<ProxyEndpoint name="default">
  <Description>Token endpoint</Description>
  <PreFlow name="PreFlow">
    <Request>
      <Step><Name>SA-Spike</Name></Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="token">
      <Description>POST /token</Description>
      <Request>
        <Step><Name>BA-Decode</Name></Step>
        <Step><Name>OA-Generate</Name></Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/token") and (request.verb = "POST")</Condition>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPProxyConnection>
    <BasePath>/v1/oauth</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="noroute"/>
</ProxyEndpoint>
